<%# Home-page concept map: every concept with its findings nested. The
    concepts index page uses the flatter `concept-list` instead. %>
<%
const concepts = [...data.wiki.concepts].sort((a, b) => a.title.localeCompare(b.title));
const findingBySlug = new Map(data.wiki.findings.map((f) => [f.slug, f]));
%>
<div class="concept-list">
<% for (const c of concepts) {
     const findings = (c.findings || []).map((s) => findingBySlug.get(s)).filter(Boolean);
%>
  <article class="concept-entry">
    <div class="concept-entry-head">
      <h3><a href="<%= c.url %>"><%= c.title %></a></h3>
      <span class="concept-entry-count"><%= findings.length %> findings</span>
      <% if (c.status) { %><%- include('primitives/status-badge', { status: c.status }) %><% } %>
    </div>
    <% if (c.blurb) { %><p class="concept-entry-blurb"><%= c.blurb %></p><% } %>
    <% if (findings.length) { %>
    <ul class="concept-entry-findings">
      <% for (const f of findings) { %>
      <li><a href="<%= f.url %>"><%= f.title %></a></li>
      <% } %>
    </ul>
    <% } %>
  </article>
<% } %>
</div>
