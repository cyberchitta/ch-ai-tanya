<%
const threads = [...data.wiki.threads].sort((a, b) => String(b.date || '').localeCompare(String(a.date || '')));
%>
<% if (!threads.length) { %>
<p class="muted">No threads filed yet.</p>
<% } else { %>
<ul class="finding-list">
  <% for (const t of threads) { %>
  <li>
    <a href="<%= t.url %>"><%= t.title %></a>
    <div class="finding-meta">
      <% if (t.status) { %><%- include('primitives/status-badge', { status: t.status }) %><% } %>
      <% if (t.date) { %><span><%= helpers.formatDate(t.date) %></span><% } %>
    </div>
  </li>
  <% } %>
</ul>
<% } %>
