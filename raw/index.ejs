---
permalink: /raw/
layout: base.ejs
eleventyExcludeFromCollections: true
title: Sources
---
<%
// Sources index — grouped by raw/ subfolder (papers, posts, system-cards,
// journalism, transcripts, tradition). The subfolder is the natural
// "kind" axis for sources; alphabetical inside each group.

const KIND_ORDER = ['papers', 'posts', 'system-cards', 'journalism', 'transcripts', 'tradition'];
const KIND_LABEL = {
  'papers':       'Papers',
  'posts':        'Posts & essays',
  'system-cards': 'System cards',
  'journalism':   'Journalism',
  'transcripts':  'Transcripts',
  'tradition':    'Tradition',
};

function kindOf(src) {
  // inputPath looks like "./raw/papers/source-foo.md"
  const m = (src.inputPath || '').match(/raw\/([^\/]+)\//);
  return m ? m[1] : 'other';
}

const grouped = new Map();
for (const s of (collections.source || [])) {
  const k = kindOf(s);
  if (!grouped.has(k)) grouped.set(k, []);
  grouped.get(k).push(s);
}
for (const arr of grouped.values()) {
  arr.sort((a, b) => helpers.byDateDesc([a, b])[0] === a ? -1 : 1);
}
const orderedKinds = [
  ...KIND_ORDER.filter((k) => grouped.has(k)),
  ...[...grouped.keys()].filter((k) => !KIND_ORDER.includes(k)).sort(),
];
%>

<%- include('primitives/entry-title-row', { title: 'Sources' }) %>

<p class="page-dek">
  Citation index. Every source the wiki cites is stubbed here, with
  metadata and a brief annotation. Findings link in via these stubs.
</p>

<hr class="rule-divider" />

<% if (!orderedKinds.length) { -%>
<p class="muted">No sources filed yet.</p>
<% } -%>

<% orderedKinds.forEach((k) => { -%>
<section style="margin-top: 2.2rem;">
  <h2 class="group-header"><%= KIND_LABEL[k] || k %></h2>
  <ul class="finding-list">
    <% grouped.get(k).forEach((s) => { -%>
    <li>
      <a href="<%= s.url %>"><%= s.data.title || s.fileSlug %></a>
      <div class="finding-meta">
        <% if (s.data.authors && s.data.authors.length) { -%>
        <span><%= s.data.authors.slice(0, 3).join(', ') %><%= s.data.authors.length > 3 ? ', et al.' : '' %></span>
        <% } -%>
        <% if (s.data.venue) { -%><span>·</span><span><%= s.data.venue %></span><% } -%>
        <% if (s.data.date) { -%><span>·</span><span><%= helpers.formatDate(s.data.date) %></span><% } -%>
      </div>
    </li>
    <% }) -%>
  </ul>
</section>
<% }) -%>
