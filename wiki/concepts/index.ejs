---
permalink: /wiki/concepts/
layout: base.ejs
eleventyExcludeFromCollections: true
title: Concepts
tags: []
---
<%
// Concepts index — alphabetical. Each entry: title, blurb, status,
// finding count. No nested finding list (that's on the home page);
// here the concept page is one click away.

const concepts = helpers.byTitle(collections.concept || []);
%>

<%- include('primitives/entry-title-row', { title: 'Concepts' }) %>

<p class="page-dek">
  Abstractions and patterns that multiple findings cluster under.
  Persist as findings are added, superseded, or reframed.
</p>

<hr class="rule-divider" />

<% if (!concepts.length) { -%>
<p class="muted">No concepts filed yet.</p>
<% } -%>

<div class="concept-list">
<% concepts.forEach((c) => {
  const fcount = (c.data.findings || []).length;
-%>
  <article class="concept-entry">
    <div class="concept-entry-head">
      <h3><a href="<%= c.url %>"><%= c.data.title %></a></h3>
      <span class="concept-entry-count"><%= fcount %> finding<%= fcount === 1 ? '' : 's' %></span>
      <% if (c.data.status) { -%>
      <%- include('primitives/status-badge', { status: c.data.status }) %>
      <% } -%>
    </div>
    <% if (c.data.blurb) { -%>
    <p class="concept-entry-blurb"><%= c.data.blurb %></p>
    <% } -%>
  </article>
<% }) -%>
</div>
