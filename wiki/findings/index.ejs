---
permalink: /wiki/findings/
layout: base.ejs
eleventyExcludeFromCollections: true
title: Findings
tags: []
---
<%
// Findings index — flat, grouped by year, newest first.
// Each row: title, status, date, models. Same vocabulary as the
// findings list on a concept page.

const all = helpers.byDateDesc(collections.finding || []);
const groups = new Map();
for (const f of all) {
  const d = f.data.date instanceof Date ? f.data.date : new Date(f.data.date || 0);
  const year = isNaN(d) ? '—' : String(d.getUTCFullYear());
  if (!groups.has(year)) groups.set(year, []);
  groups.get(year).push(f);
}
const years = [...groups.keys()].sort((a, b) => b.localeCompare(a));
%>

<%- include('primitives/entry-title-row', { title: 'Findings' }) %>

<p class="page-dek">
  Time-stamped empirical results tied to specific sources, models, and
  dates. Findings cluster under <a href="/wiki/concepts/">concepts</a>;
  read either way in.
</p>

<hr class="rule-divider" />

<% if (!all.length) { -%>
<p class="muted">No findings filed yet.</p>
<% } -%>

<% years.forEach((y) => { -%>
<section style="margin-top: 2.2rem;">
  <h2 class="group-header"><%= y %></h2>
  <ul class="finding-list">
    <% groups.get(y).forEach((f) => { -%>
    <li>
      <a href="<%= f.url %>"><%= f.data.title %></a>
      <div class="finding-meta">
        <% if (f.data.status) { -%>
        <%- include('primitives/status-badge', { status: f.data.status }) %>
        <% } -%>
        <% if (f.data.date) { -%><span><%= helpers.formatDate(f.data.date) %></span><% } -%>
        <% if (f.data.models && f.data.models.length) { -%>
        <span>·</span><span><%= f.data.models.join(', ') %></span>
        <% } -%>
      </div>
    </li>
    <% }) -%>
  </ul>
</section>
<% }) -%>
