---
permalink: /wiki/researchers/
layout: base.ejs
eleventyExcludeFromCollections: true
title: Researchers
tags: []
---
<%
const researchers = helpers.byTitle(collections.researcher || []);
%>

<%- include('primitives/entry-title-row', { title: 'Researchers' }) %>

<p class="page-dek">
  Active researchers, teams, and labs whose work shows up repeatedly
  across findings.
</p>

<hr class="rule-divider" />

<% if (!researchers.length) { -%>
<p class="muted">No researchers filed yet.</p>
<% } else { -%>
<ul class="backlink-list">
  <% researchers.forEach((r) => { -%>
  <li>
    <a href="<%= r.url %>"><%= r.data.title %></a>
    <% if (r.data.affiliation) { -%>
    <span class="muted"> — <%= r.data.affiliation %></span>
    <% } -%>
  </li>
  <% }) -%>
</ul>
<% } -%>
