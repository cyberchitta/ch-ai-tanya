---
permalink: /wiki/threads/
layout: base.ejs
eleventyExcludeFromCollections: true
title: Threads
tags: []
---
<%
const threads = helpers.byDateDesc(collections.thread || []);
%>

<%- include('primitives/entry-title-row', { title: 'Threads' }) %>

<p class="page-dek">
  Developing arguments and patterns tracked across findings. When a
  thread gets sharp enough, it becomes a publication.
</p>

<hr class="rule-divider" />

<% if (!threads.length) { -%>
<p class="muted">No threads filed yet.</p>
<% } else { -%>
<ul class="finding-list">
  <% threads.forEach((t) => { -%>
  <li>
    <a href="<%= t.url %>"><%= t.data.title %></a>
    <div class="finding-meta">
      <% if (t.data.status) { -%>
      <%- include('primitives/status-badge', { status: t.data.status }) %>
      <% } -%>
      <% if (t.data.date) { -%><span><%= helpers.formatDate(t.data.date) %></span><% } -%>
    </div>
  </li>
  <% }) -%>
</ul>
<% } -%>
